NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Used to sign login cookies. Keep this stable across deploys.
SESSION_SECRET=

# Optional one-time bootstrap user. On first login, the app creates this user
# if admin_users is empty. After that, credentials live in the database.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cron endpoints still use this shared secret.
CRON_SECRET=

# Optional local/dev fallbacks. In production, enter these in /settings per user.
ETSY_API_KEY=
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
ETSY_REDIRECT_URI=
ETSY_SHOP_ID=
PINTEREST_ENABLED=true
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_USER_ID=
INSTAGRAM_ENABLED=
INSTAGRAM_POST_MODE=single
META_API_VERSION=v25.0
MAX_PINS_PER_RUN=10
MAX_PIN_RETRIES=3
MAX_INSTAGRAM_POSTS_PER_RUN=5
MAX_INSTAGRAM_RETRIES=3
DRY_RUN=true

# Process-level Instagram polling/media limits.
INSTAGRAM_CONTAINER_MAX_POLLS=6
INSTAGRAM_CONTAINER_POLL_INTERVAL_MS=1000
INSTAGRAM_CAROUSEL_MAX_ITEMS=10
